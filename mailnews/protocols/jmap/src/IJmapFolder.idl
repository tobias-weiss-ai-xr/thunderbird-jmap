#include "nsISupports.idl"

/**
 * IJmapFolder extends nsIMsgFolder with JMAP-specific properties and
 * operations.
 */
[scriptable, uuid(23456789-abcd-ef01-2345-67890abcdef0)]
interface IJmapFolder : nsISupports
{
  /**
   * The JMAP Mailbox ID for this folder.
   */
  readonly attribute AUTF8String jmapMailboxId;

  /**
   * The JMAP role for this mailbox (e.g., "inbox", "sent", "trash", etc.).
   */
  readonly attribute AUTF8String jmapRole;

  /**
   * The JMAP sort order for this mailbox.
   */
  readonly attribute long jmapSortOrder;

  /**
   * The current JMAP state token for this mailbox's message list.
   * Used for delta-sync via Email/changes.
   */
  attribute AUTF8String emailStateToken;
};
