#include "nsISupports.idl"

/**
 * JMAP-specific folder interface.
 */
[scriptable, uuid(a2345678-90ab-cdef-1234-567890abcdef)]
interface IJmapFolder : nsISupports
{
  /**
   * The JMAP mailbox ID for this folder, as assigned by the server.
   * This is the unique identifier used in JMAP API calls.
   */
  attribute ACString jmapMailboxId;

  /**
   * The JMAP mailbox role (e.g., "inbox", "archive", "drafts", "sent", "trash", "junk").
   * Empty string if no role is assigned.
   */
  readonly attribute ACString jmapRole;

  /**
   * The sort order of this mailbox on the server.
   */
  readonly attribute long jmapSortOrder;

  /**
   * The total number of messages in this mailbox.
   */
  attribute long totalMessages;

  /**
   * The number of unread messages in this mailbox.
   */
  attribute long unreadMessages;

  /**
   * The total number of threads in this mailbox.
   */
  attribute long totalThreads;

  /**
   * The number of unread threads in this mailbox.
   */
  attribute long unreadThreads;

  /**
   * The mailbox state token (for delta sync).
   */
  readonly attribute ACString jmapMailboxState;
};
