EXPORTS += [
    "JmapClient.h",
    "JmapFolder.h",
    "JmapFolderSyncListener.h",
    "JmapIncomingServer.h",
    "JmapMessageChannel.h",
    "JmapProtocolHandler.h",
    "JmapProtocolInfo.h",
    "JmapService.h",
    "JmapUtils.h",
]

UNIFIED_SOURCES += [
    "JmapClient.cpp",
    "JmapFolder.cpp",
    "JmapFolderSyncListener.cpp",
    "JmapIncomingServer.cpp",
    "JmapListeners.cpp",
    "JmapMessageChannel.cpp",
    "JmapProtocolHandler.cpp",
    "JmapProtocolInfo.cpp",
    "JmapService.cpp",
    "JmapUtils.cpp",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

XPIDL_MODULE = "msgjmap"

XPIDL_SOURCES += [
    "IJmapClient.idl",
    "IJmapFolder.idl",
    "IJmapIncomingServer.idl",
]

FINAL_LIBRARY = "mail"
